# Application
APP_NAME=EnterpriseRAG
ENV=production

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./app.db

cat > .env.example << 'EOF'
# ─────────────────────────────────────────────────────────────
# EnterpriseRAG-AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/enterpriserag

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenTelemetry ─────────────────────────────────────────────
# Service name appears in Jaeger UI traces
OTEL_SERVICE_NAME=enterpriserag-api

# OTLP exporter endpoint — points to Jaeger's gRPC collector port
# When running via docker-compose, use the service name: http://jaeger:4317
# When running locally (no Docker), use: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Exporter protocol: otlp (gRPC) or otlp-http (HTTP/protobuf)
OTEL_TRACES_EXPORTER=otlp

# Set to "none" to disable tracing (e.g. in unit tests)
# OTEL_TRACES_EXPORTER=none

# ── LLM API ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Or use a local model endpoint:
# LLM_BASE_URL=http://localhost:11434

# ── FAISS ─────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss.index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EOF